# description: Exclusiones de git: secretos, venv, node_modules, .next, datos locales y *.skill.
# context: Evita subir .env, uploads MIDI y artefactos generados.

# Secrets and local environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pyre/

# Node / Next.js
node_modules/
.next/
out/
.nx/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Local data and user uploads
data/*.db
data/*.sqlite
data/*.sqlite3
data/midi/*
data/uploads/*
data/sessions/*
!data/midi/.gitkeep
!data/uploads/.gitkeep
!data/sessions/.gitkeep
# El catálogo de metadatos (título, licencia, source_url, dificultad) sí se versiona;
# los .mid del corpus son de terceros (Mutopia) y no se versionan.
!data/midi/catalog.json
# Excepción: la pieza de práctica propia (p16, CC0) sí viaja con el repositorio.
# Hay que re-incluir la carpeta antes del archivo, porque `data/midi/*` la excluía.
!data/midi/corpus/
data/midi/corpus/*
!data/midi/corpus/practice_phrase.mid

# Logs and runtime files
*.log
logs/
*.pid

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker local overrides
docker-compose.override.yml

# Build and generated artifacts
build/
dist/
*.egg-info/
.work/

# Skill package/build artifacts
*.skill
opencode.exe

# frontend/tsconfig.json sí se versiona: es quien define el alias "@/*" de los imports.
# (next-env.d.ts y *.tsbuildinfo ya quedan fuera por las reglas de Node/Next.)

# Banco de muestras de piano descargado (Salamander, ~78 MB, regenerable con `npm run samples`).
# Los MP3 derivados de frontend/public/audio/piano/ sí se versionan; atribución en THIRD_PARTY_NOTICES.md.
frontend/.cache/
nota.txt
