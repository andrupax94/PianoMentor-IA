# description: Exclusiones de git: secretos, venv, node_modules, .next, datos locales y *.skill.
# context: Evita subir .env, uploads MIDI y artefactos generados.

# Secrets and local environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pyre/

# Node / Next.js
node_modules/
.next/
out/
.nx/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Local data and user uploads
data/*.db
data/*.sqlite
data/*.sqlite3
data/midi/*
data/uploads/*
data/sessions/*
!data/midi/.gitkeep
!data/uploads/.gitkeep
!data/sessions/.gitkeep
# El catálogo de metadatos (título, licencia, source_url, dificultad) sí se versiona;
# los .mid del corpus son de terceros (Mutopia) y no se versionan.
!data/midi/catalog.json

# Logs and runtime files
*.log
logs/
*.pid

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker local overrides
docker-compose.override.yml

# Build and generated artifacts
build/
dist/
*.egg-info/
.work/

# Skill package/build artifacts
*.skill
opencode.exe
frontend/tsconfig.json
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts
