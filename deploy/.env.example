# description: Variables del stack de servidor (dominios y flags de build).
# context: Copiar a deploy/.env. No contiene secretos: los secretos viven en ../.env.

# URL pública del frontend (la que se escribe en el navegador).
PM_PUBLIC_WEB_URL=https://www.pianomentoria.com

# URL pública del backend (API REST y WebSocket). El WebSocket debe ir en wss://
# o el navegador bloqueara la conexion por contenido mixto.
PM_PUBLIC_API_URL=https://api.pianomentoria.com
PM_PUBLIC_WS_URL=wss://api.pianomentoria.com

# Interfaz de subida de MIDI. false = oculta el botón en un servidor público.
PM_ENABLE_MIDI_UPLOAD=false

# Carpeta del SQLite de PRODUCCIÓN, fuera del repositorio. Debe existir y ser
# escribible por el usuario que lanza docker compose.
#   mkdir -p ~/.local/share/pianomentor/prod
# Vacía a propósito: el compose se niega a arrancar sin ella, para que nadie
# acabe montando el data/ de desarrollo sobre la base de producción.
PM_DATA_DIR=/home/CAMBIA_ESTO/.local/share/pianomentor/prod
