# description: Configuración del actualizador de IP dinámica (Vercel).
# context: Copiar a /etc/pm-ddns.env con permisos 0600. El token da acceso a tu DNS.

# Token de https://vercel.com/account/tokens (permiso de cuenta completa).
VERCEL_TOKEN=pega_aqui_tu_token

# Dominio y registros que se actualizan.
VERCEL_DOMAIN=pianomentoria.com
VERCEL_RECORDS=@,www,api

# Opcional: solo si el dominio vive en un equipo. Sin esto, la API devuelve
# 403 "You don't have permission to list the domain record".
# Lo imprime deploy/ddns/diagnose-token.sh.
VERCEL_TEAM_ID=

# TTL bajo para que el cambio se propague rápido cuando la IP cambie.
VERCEL_TTL=60
