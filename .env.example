# description: Plantilla de variables de entorno sin secretos (puertos, CORS, rutas MIDI, Groq).
# context: Copiar a .env para desarrollo; nunca commitear valores reales.

APP_NAME=PianoMentor AI
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/piano_mentor.db
MIDI_STORAGE_PATH=/data/midi
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

GROQ_API_KEY=
GEMINI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=PianoMentor

ADMIN_EMAIL=
# AUTOLOGIN=false solo vale fuera de producción: con true, las credenciales
# vacías del login inician sesión con la cuenta ADMIN_EMAIL (cuenta admin).
AUTOLOGIN=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret de las sesiones (Auth.js y JWT del login con contraseña);
# generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# U-006: registro por pasos (URL pública del front para el EMAIL de verificación
# y caducidad del token de activación). Sin proveedor de email, el enlace sale
# en el log del backend (punto único a sustituir por SMTP en mailer.py).
APP_PUBLIC_URL=http://localhost:3000
VERIFICATION_TOKEN_TTL_H=24
