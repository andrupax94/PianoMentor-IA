# description: Plantilla de variables de entorno sin secretos (puertos, CORS, rutas MIDI, Groq).
# context: Copiar a .env para desarrollo; nunca commitear valores reales.

APP_NAME=PianoMentor AI
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/piano_mentor.db
MIDI_STORAGE_PATH=/data/midi
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

GROQ_API_KEY=
GEMINI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=PianoMentor

ADMIN_EMAIL=
# AUTOLOGIN=false solo vale fuera de producción: con true, las credenciales
# vacías del login inician sesión con la cuenta ADMIN_EMAIL (cuenta admin).
AUTOLOGIN=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret de las sesiones (Auth.js y JWT del login con contraseña);
# generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# U-006: registro por pasos. APP_PUBLIC_URL es el front (enlaces de la página
# de verificación) y API_PUBLIC_URL, si se define, la base del enlace del
# email (dominio del backend en producción). Sin proveedor de email, el
# enlace sale en el log (mailer.py).
APP_PUBLIC_URL=http://localhost:3000
# API_PUBLIC_URL=
VERIFICATION_TOKEN_TTL_H=24

# U-006: envío del email de verificación vía Resend (https://resend.com).
# Con la clave vacía el mailer queda hermético (solo log). Mientras no haya
# dominio propio verificado en Resend, EMAIL_FROM debe ser onboarding@resend.dev
# y Resend solo entrega al correo de la cuenta dueña de la API key.
RESEND_API_KEY=
EMAIL_FROM=PianoMentor AI <onboarding@resend.dev>

#CLOUDFFLARE R2
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pianomentor-db
